rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isChatOwner(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredModel', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'preferredModel', 'theme', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.preferredModel in ['gemini-4-hydrogen', 'gemini-4-argon', 'gemini-4-carbon']
        && data.theme in ['dark', 'light']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatThread(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'model', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'model', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, chatId) {
      return data.keys().hasAll(['id', 'chatId', 'userId', 'role', 'content', 'model', 'hasAttachment', 'createdAt'])
        && data.keys().hasOnly(['id', 'chatId', 'userId', 'role', 'content', 'model', 'hasAttachment', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.chatId)
        && data.chatId == chatId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 100000
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 80
        && data.hasAttachment is bool
        && data.createdAt is timestamp;
    }

    function isValidWorkspaceProject(data) {
      return data.keys().hasAll(['id', 'userId', 'kind', 'title', 'prompt', 'code', 'language', 'summary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'kind', 'title', 'prompt', 'code', 'language', 'summary', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.kind in ['website', 'debug']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.prompt is string && data.prompt.size() <= 10000
        && data.code is string && data.code.size() <= 250000
        && data.language is string && data.language.size() <= 60
        && data.summary is string && data.summary.size() <= 20000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredModel', 'theme', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /chats/{chatId} {
      allow get: if isValidId(chatId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(chatId)
        && isVerifiedUser()
        && isValidChatThread(incoming())
        && incoming().id == chatId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(chatId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid
        && isValidChatThread(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'model', 'updatedAt']);
      allow delete: if isValidId(chatId) && isSignedIn() && existing().userId == request.auth.uid;

      match /messages/{messageId} {
        allow get: if isValidId(chatId) && isValidId(messageId) && isChatOwner(chatId);
        allow list: if isValidId(chatId) && isSignedIn() && resource.data.userId == request.auth.uid && resource.data.chatId == chatId;
        allow create: if isValidId(chatId)
          && isValidId(messageId)
          && isVerifiedUser()
          && isValidChatMessage(incoming(), chatId)
          && incoming().id == messageId
          && incoming().createdAt == request.time
          && isChatOwner(chatId);
        allow update: if false;
        allow delete: if isValidId(chatId) && isValidId(messageId) && isChatOwner(chatId);
      }
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(projectId)
        && isVerifiedUser()
        && isValidWorkspaceProject(incoming())
        && incoming().id == projectId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid
        && isValidWorkspaceProject(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'prompt', 'code', 'language', 'summary', 'updatedAt']);
      allow delete: if isValidId(projectId) && isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
