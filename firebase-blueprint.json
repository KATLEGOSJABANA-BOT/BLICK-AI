{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and workspace preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "preferredModel": {
          "type": "string",
          "enum": ["gemini-4-hydrogen", "gemini-4-argon", "gemini-4-carbon"]
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "preferredModel", "theme", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "A multi-turn AI chat conversation thread owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "model", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message within a chat thread.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "maxLength": 100000
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "hasAttachment": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "chatId", "userId", "role", "content", "model", "hasAttachment", "createdAt"]
    },
    "WorkspaceProject": {
      "title": "WorkspaceProject",
      "description": "Saved website builder or code debugger project owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["website", "debug"]
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "prompt": {
          "type": "string",
          "maxLength": 10000
        },
        "code": {
          "type": "string",
          "maxLength": 250000
        },
        "language": {
          "type": "string",
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "maxLength": 20000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "kind", "title", "prompt", "code", "language", "summary", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and workspace settings."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "User chat conversation metadata."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Individual messages belonging to a chat thread."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/WorkspaceProject" },
      "description": "Saved website builder HTML projects and code debugger sessions."
    }
  }
}
